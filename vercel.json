{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/",
      "dest": "/public/index.html"
    },
    {
      "src": "/login",
      "dest": "/public/login.html"
    },
    {
      "src": "/dashboard",
      "dest": "/public/dashboard.html"
    },
    {
      "src": "/church",
      "dest": "/public/church.html"
    },
    {
      "src": "/masses",
      "dest": "/public/masses.html"
    },
    {
      "src": "/services",
      "dest": "/public/services.html"
    },
    {
      "src": "/events",
      "dest": "/public/events.html"
    },
    {
      "src": "/news",
      "dest": "/public/news.html"
    },
    {
      "src": "/sermons",
      "dest": "/public/sermons.html"
    },
    {
      "src": "/gallery",
      "dest": "/public/gallery.html"
    },
    {
      "src": "/priests",
      "dest": "/public/priests.html"
    },
    {
      "src": "/saints",
      "dest": "/public/saints.html"
    },
    {
      "src": "/faq",
      "dest": "/public/faq.html"
    },
    {
      "src": "/search",
      "dest": "/public/search.html"
    },
    {
      "src": "/prayer-request",
      "dest": "/public/prayer-request.html"
    },
    {
      "src": "/contact",
      "dest": "/public/contact.html"
    },
    {
      "src": "/api/(.*)",
      "dest": "server.js"
    },
    {
      "src": "/(.*)",
      "dest": "/public/404.html"
    }
  ]
}